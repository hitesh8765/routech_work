# Copy this file to .env and fill in real values (never commit .env itself).

ROUTECH_BASE_URL=https://liveroutech.demoe2.com

ROUTECH_B2B_EMAIL=neeraj@mailinator.com
ROUTECH_B2B_PASSWORD=123456

ROUTECH_C2C_EMAIL=bharti@mailinator.com
ROUTECH_C2C_PASSWORD=Test@123

# "1" = run login browser headless (you won't be able to solve the captcha!)
# Keep "0" until we have a captcha-bypass/whitelist strategy for the demo env.
ROUTECH_UI_HEADLESS=0

# Seconds before we consider a cached session stale and re-login.
# Observed real session lifetime on the demo env is ~1 hour (3600s).
ROUTECH_SESSION_MAX_AGE=3300
